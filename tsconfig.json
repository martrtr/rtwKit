{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "web/**/*.ts",
    "web/**/*.tsx",
    "packages/web-ui/**/*.ts",
    "packages/web-ui/**/*.tsx",
    "packages/dice/**/*.ts",
    "packages/dice/**/*.tsx",
    "packages/chat/**/*.ts",
    "packages/chat/**/*.tsx"
  ]
}
