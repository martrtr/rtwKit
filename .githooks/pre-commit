#!/usr/bin/env bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"
cd "$repository_root"

if command -v nix >/dev/null 2>&1 && [[ -f flake.nix ]]; then
    exec nix develop --no-write-lock-file --command bash scripts/check.sh
fi

if command -v rustup >/dev/null 2>&1; then
    exec bash scripts/check.sh
fi

echo "pre-commit requires Nix or rustup with the repository Rust toolchain." >&2
exit 1
