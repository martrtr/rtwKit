{
  "format": "rintawa.web.experience-pack@1",
  "id": "rintawa.web.standard",
  "name": "Rintawa Standard",
  "theme": {
    "tokens": {
      "ui.color.text.primary": "#f4f4f5",
      "ui.color.text.muted": "#a1a1aa",
      "ui.color.surface.primary": "#18181b",
      "ui.color.surface.secondary": "#27272a",
      "ui.color.accent": "#a5b4fc",
      "ui.color.warning": "#fde68a",
      "ui.color.error": "#fca5a5",
      "ui.color.success": "#86efac",
      "ui.spacing.compact": "0.5rem",
      "ui.spacing.normal": "0.75rem",
      "ui.spacing.relaxed": "1rem",
      "ui.radius.control": "0.5rem",
      "ui.font.body": "Inter, ui-sans-serif, system-ui, sans-serif",
      "ui.font.heading": "Inter, ui-sans-serif, system-ui, sans-serif",
      "ui.font.monospace": "ui-monospace, SFMono-Regular, monospace",
      "web.color.background": "#111113",
      "web.color.border": "#2c2c31",
      "web.color.control-border": "#3f3f46",
      "web.radius.surface": "0.75rem",
      "web.workbench.activity-rail-width": "3rem",
      "web.workbench.horizontal-activity-bar-height": "3.7rem",
      "web.workbench.dock-min-width": "13rem",
      "web.workbench.tab-height": "2.35rem",
      "web.workbench.section-nav-width": "12rem",
      "web.workbench.section-nav-min-width": "9rem",
      "web.workbench.section-nav-max-width": "18rem",
      "web.motion.fast": "120ms",
      "web.motion.normal": "180ms",
      "web.motion.easing": "cubic-bezier(0.2, 0, 0, 1)",
      "web.color-scheme": "dark",
      "web.collection.media-row-min-height": "5.25rem",
      "web.collection.thumbnail-size": "4rem",
      "web.chat.max-width": "64rem",
      "web.chat.avatar-size": "3rem",
      "web.chat.composer-min-height": "3.25rem"
    },
    "icons": {
      "activity.extensions": "packages",
      "activity.management": "tool",
      "activity.extension": "puzzle",
      "action.download": "download",
      "action.update": "upload",
      "action.remove": "trash",
      "action.settings": "settings",
      "action.search": "search",
      "action.more": "dots",
      "status.warning": "warning",
      "status.success": "check",
      "repository.generic": "database",
      "fallback.package": "package",
      "fallback.generic": "box",
      "activity.worlds": "world",
      "world.thumbnail": "world",
      "participant.local": "user",
      "participant.remote": "sparkles"
    }
  },
  "shell": {
    "workspace": {
      "type": "region",
      "region": "main",
      "weight": 1
    },
    "layers": [
      {
        "region": "status",
        "presentation": "status"
      },
      {
        "region": "dialog",
        "presentation": "dialog"
      },
      {
        "region": "overlay",
        "presentation": "overlay"
      }
    ],
    "region_presentations": [
      {
        "region": "main",
        "label": "Main",
        "mode": "activity-tabs",
        "accepts_activities": true,
        "collapsible": false
      }
    ],
    "activity_bar": {
      "presentation": "vertical-start"
    },
    "rules": [
      {
        "match": {
          "semantic": "management.extensions@1"
        },
        "region": "main"
      },
      {
        "match": {
          "trait": "navigation"
        },
        "region": "main"
      },
      {
        "match": {
          "trait": "inspector"
        },
        "region": "main"
      },
      {
        "match": {
          "trait": "workspace-tool"
        },
        "region": "main"
      },
      {
        "match": {
          "trait": "settings"
        },
        "region": "main"
      },
      {
        "match": {
          "trait": "scene-primary"
        },
        "region": "main"
      },
      {
        "match": {
          "trait": "scene-secondary"
        },
        "region": "main"
      },
      {
        "match": {
          "placement": "primary"
        },
        "region": "main"
      },
      {
        "match": {
          "placement": "secondary"
        },
        "region": "main"
      },
      {
        "match": {
          "placement": "settings"
        },
        "region": "main"
      },
      {
        "match": {
          "placement": "sidebar"
        },
        "region": "main"
      },
      {
        "match": {
          "placement": "status"
        },
        "region": "status"
      },
      {
        "match": {
          "placement": "dialog"
        },
        "region": "dialog"
      },
      {
        "match": {
          "placement": "overlay"
        },
        "region": "overlay"
      }
    ],
    "fallback_region": "main"
  }
}
